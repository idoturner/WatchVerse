# TMDB API configuration (see docs/03-architecture/tmdb-integration.md)
# Note: in a client-only app this credential is exposed to the browser — this is an
# accepted, documented reality with a mitigation plan (see docs/03-architecture/security-and-privacy.md).
VITE_TMDB_API_BASE=https://api.themoviedb.org/3
VITE_TMDB_IMAGE_BASE=https://image.tmdb.org/t/p
# Your TMDB v4 read access token (read-scoped):
VITE_TMDB_ACCESS_TOKEN=your_tmdb_v4_read_access_token_here

# --- Weekly WatchVerse Recap automation (optional) ---
# Sends movie activity events to an n8n webhook; n8n stores them in Google Sheets and emails a
# weekly recap. WatchVerse works normally if these are left blank. See docs/weekly-watchverse-recap.md.
# NOTE: VITE_* values are inlined into the browser bundle — not a real secret. n8n must validate
# source="watchverse", eventType="movie_activity", and automationKey before storing rows.
VITE_WEEKLY_RECAP_WEBHOOK_URL=
VITE_WEEKLY_RECAP_AUTOMATION_KEY=
